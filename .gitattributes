# Normalise line endings so a Windows/WSL checkout cannot introduce CRLF.
#
# This matters beyond cosmetics:
#   - src/tools/**/prompt.md is inlined verbatim into the CLI bundle by
#     scripts/build-cli.js; CRLF there ends up in every tool description.
#   - fixtures/ and snapshot-style test expectations compare byte-for-byte.
#   - the edit_file tool does exact-substring matching, so a CRLF working tree
#     makes model-produced (LF) edits fail to match.
* text=auto eol=lf

# Shell scripts must stay LF or they will not execute (`bad interpreter: ^M`).
*.sh text eol=lf

# Binary payloads — never touch.
*.tgz binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.npz binary
*.zip binary
