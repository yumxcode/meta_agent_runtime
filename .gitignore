# Dependencies
node_modules/
.npm-cache/

# Build output (produced by `npm run build`; published via npm, not git)
dist/

# Packaged tarballs
*.tgz

# Local review / transfer staging
_pack_src_stage*
_review_src_snapshot*
_stage_parts/
_to_delete/
__wtest__
_show_worker_prompt.mts

# Logs / debug
*.log
.DS_Store

# FUSE artifacts (deleted-but-open files on FUSE mounts)
.fuse_hidden*

# Runtime write artifacts (atomic-write temps, corrupt quarantine, lock files)
*.corrupt
*.tmp
*.lock

# Editor / tooling
.vscode/
.idea/

# Local runtime state
.meta-agent/
permissions.json
_tmp_branchcycle.removed
__trash_stale_auto_orch/

# NOTE: `src/core/auto_orch/` used to be listed here, left over from retiring
# the v1 auto-orchestration engine. Its files are long gone, but the rule
# outlived them and had become a trap: anything created under that path would
# be invisible to `git status` and silently skipped by `git add .`. An ignore
# rule inside src/ is a landmine; deleted deliberately.
